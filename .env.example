# Yerel geliştirme: Vite proxy /api → backend
VITE_API_URL=/api
VITE_DEV_API_PROXY=http://127.0.0.1:4000

# Local backend kapalıysa (port 4000) yukarıdaki satırı yorumlayıp Railway kullanın:
# VITE_DEV_API_PROXY=https://websitebackend-production-ab6e.up.railway.app

# Yalnızca `vite preview` / prerender (npm run build) için opsiyonel override:
# VITE_PRERENDER_API_PROXY=https://websitebackend-production-ab6e.up.railway.app

# Production (Vercel): /api göreli yol — vercel.json Railway'e proxy eder
# VITE_BACKEND_PUBLIC_URL=
# VITE_UPLOADS_BASE_URL=
